# Copy this file to .env and fill in any values you want to override.
# All variables are optional — the defaults work for a standard installation.

# Tikitaka REST API base URL (no trailing slash)
# TIKITAKA_API_BASE_URL=https://api.manage.tikitaka.lv

# Directory where the warehouse, raw lake, staging lake, and logs are stored.
# Defaults to the platform user-data folder (e.g. %LOCALAPPDATA%\TikiTakaPAYDWH on Windows).
# TIKITAKA_APP_DATA_DIR=C:\TikiTakaPAYDWH\data

# Sentry DSN for opt-in crash reporting.  Leave blank (or unset) to disable.
# TIKITAKA_SENTRY_DSN=

# Logging level: DEBUG | INFO | WARNING | ERROR  (default: INFO)
# TIKITAKA_LOG_LEVEL=INFO

# --- Credential encryption (headless / server deployments only) ---
# On a normal desktop installation the OS keychain is used and nothing below
# is needed.  On a headless server without a keychain (e.g. a Docker container),
# the app falls back to an encrypted file.  A unique per-machine key is
# generated automatically the first time the file is written.
#
# To supply the passphrase via MDM or CI instead of the auto-generated key:
# TIKITAKA_CRED_PASSPHRASE=<strong-random-passphrase>
#
# API credentials can also be injected directly (overrides the keychain):
# TIKITAKA_CLIENT_ID=your_client_id
# TIKITAKA_CLIENT_SECRET=your_client_secret
